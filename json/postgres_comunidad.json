    {
      "nombre": "tendencias_en_redes_por_categoria",
      "por_que_es_importante": "Cruza Tendencias_Redes y Categorias_Interes. Detecta qué temas están de moda en las redes y cuáles son sus palabras clave más buscadas, para anticiparse a lo que pedirán alumnos y vecinos.",
      "sql": "SELECT c.nombre_categoria, SUM(t.volumen_busquedas) AS busquedas_totales, MAX(t.volumen_busquedas) AS maximo_una_palabra, COUNT(t.id_tendencia) AS palabras_clave FROM Tendencias_Redes t JOIN Categorias_Interes c ON c.id_categoria = t.id_categoria GROUP BY c.nombre_categoria ORDER BY busquedas_totales DESC",
