      "nombre": "interes_de_alumnos_frente_a_tendencias_en_redes",
      "por_que_es_importante": "Cruza Categorias_Interes, Preferencias_Alumnos y Tendencias_Redes. Compara lo que piden los alumnos con lo que está de moda fuera del instituto y detecta temas con mucha demanda en redes y poca oferta interna.",
      "sql": "SELECT c.nombre_categoria, (SELECT ROUND(AVG(pa.nivel_interes), 2) FROM Preferencias_Alumnos pa WHERE pa.id_categoria = c.id_categoria) AS interes_medio_alumnos, (SELECT COALESCE(SUM(t.volumen_busquedas), 0) FROM Tendencias_Redes t WHERE t.id_categoria = c.id_categoria) AS busquedas_en_redes FROM Categorias_Interes c ORDER BY busquedas_en_redes DESC",
